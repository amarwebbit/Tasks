# Supabase Configuration (Get these from your Supabase Cloud Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend Email Configuration (Get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="Trinetra Tasks <tasks@yourdomain.com>"

# Application Base URL (Used for generating deep links in email notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000
